# No secret belongs in this file. Configure credentials only in your AWS runtime.
# AWS account identity is intentionally omitted; deployment resolves it via STS.
AWS_PROFILE=default
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
DEPLOYMENT_REVISION=local-unverified
# Set only from verified CloudFormation outputs in the deployed façade.
AGENTCORE_RUNTIME_ARN=UNKNOWN
